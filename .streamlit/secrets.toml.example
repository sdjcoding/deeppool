# Copy this file to .streamlit/secrets.toml and edit the values.
# secrets.toml is gitignored — never commit a real password.
#
# Streamlit reads it via st.secrets["app_password"].

app_password = "change-me-to-a-long-password"

# Optional: Anthropic API key for AI 해설 buttons in ETF Detail / Strategies pages.
# If unset, the buttons show a "key not configured" message and the app still works.
# Get a key at https://console.anthropic.com — pick "Workspace API key".
# anthropic_api_key = "sk-ant-api03-..."
